# Environment Configuration for Restaurant Food Ordering Platform

# Core Django Settings
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Site Base URL (Used for generating publicly accessible QR codes)
# In production, set to your real domain (e.g. https://orders.yourrestaurant.com)
SITE_BASE_URL=http://127.0.0.1:8000

# Database Configuration (MySQL recommended for production)
# Set DB_ENGINE=mysql to use MySQL, or leave as sqlite3 for local development
DB_ENGINE=sqlite3
DB_NAME=restaurant_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# Media and Static
MEDIA_URL=/media/
STATIC_URL=/static/

